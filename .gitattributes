# 默认：文本文件入库用 LF，工作区按平台检出
* text=auto

# Windows 平台项目：C# 源码按 CRLF 检出（与 IDE 一致）
*.cs text eol=crlf
*.csproj text eol=crlf
*.manifest text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 脚本类保持 LF
*.py text eol=lf
*.sh text eol=lf

# 二进制，禁止行尾转换
*.ico binary
*.png binary
*.jpg binary
*.exe binary
*.dll binary
*.pdb binary
